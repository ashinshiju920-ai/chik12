{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chik12",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-03",
  "build": {
    "command": "bun run build || npm run build"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "CASHFREE_APP_ID": "1394821550ebfb4bd846f673e571284931"
  }
}
